DEBUG=True
SECRET_KEY=cambia-esto-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend (separados por coma, con https en producción)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Atajo: URL pública del frontend (la agrega a CORS automáticamente)
# FRONTEND_URL=https://tu-dominio.com

# Base de datos — PostgreSQL (recomendado)
DB_ENGINE=postgresql
DB_NAME=isijara
DB_USER=isijara
DB_PASSWORD=isijara
DB_HOST=127.0.0.1
DB_PORT=5432

# Solo para importar datos viejos: DB_ENGINE=sqlite
